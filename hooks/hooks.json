{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.venv/Scripts/python.exe",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/companion/launcher.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47621/hook?from=cc-companion",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.venv/Scripts/python.exe",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/companion/launcher.py",
              "--revive"
            ],
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47621/hook?from=cc-companion",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47621/hook?from=cc-companion",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47621/hook?from=cc-companion",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47621/hook?from=cc-companion",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47621/hook?from=cc-companion",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47621/hook?from=cc-companion",
            "timeout": 1
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47621/hook?from=cc-companion",
            "timeout": 1
